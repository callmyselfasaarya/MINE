# M.I.N.E MVP Configuration
# Obtain your free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Assistant Settings
ASSISTANT_NAME=MINE
USER_NAME=Sir

# Voice Configuration
TTS_ENABLED=true
TTS_RATE=190
TTS_VOLUME=1.0
STT_ENERGY_THRESHOLD=300
STT_PAUSE_THRESHOLD=0.8

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false
