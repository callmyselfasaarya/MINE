# M.I.N.E MVP Configuration

# AI / LLM Provider: 'ollama', 'gemini', or 'local'
LLM_PROVIDER=ollama

# Ollama Local LLM Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=25

# Assistant Settings
ASSISTANT_NAME=MINE
USER_NAME=Sir

# Voice Configuration
TTS_ENABLED=true
TTS_RATE=190
TTS_VOLUME=1.0
STT_ENERGY_THRESHOLD=300
STT_PAUSE_THRESHOLD=0.8

# Wake Word Configuration
# Phrase that activates the assistant when wake-word mode is on
WAKE_WORD=hey mine
# Set to true to auto-start wake-word detection on launch
WAKE_WORD_ENABLED=false
# Comma-separated extra aliases (optional)
WAKE_WORD_ALIASES=mine,hey jarvis

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false