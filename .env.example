# M.I.N.E MVP Configuration

# AI / LLM Provider: 'ollama', 'gemini', or 'local'
LLM_PROVIDER=ollama

# Ollama Local LLM Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=25

# (Optional) Google Gemini Configuration
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Assistant Settings
ASSISTANT_NAME=MINE
USER_NAME=Sir

# Voice Configuration
TTS_ENABLED=true
TTS_RATE=190
TTS_VOLUME=1.0
STT_ENERGY_THRESHOLD=300
STT_PAUSE_THRESHOLD=0.8

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false